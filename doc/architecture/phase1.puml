@startuml
left to right direction
skinparam componentStyle rectangle
component "main.ts\n固定装配" as main
component "CLI\nCommandFactory：内置名称表" as cli
component "Application\n命令 / Receiver / History" as app
component "Domain\nShapeFactory：内置形状表\nShape / Group / SvgDocument" as domain
component "Infrastructure\nSVG Codec / FileStore" as infra
main --> cli
main --> app
main --> infra
cli --> app
app --> domain
infra --> domain
infra --> app : implements DocumentStore
note bottom of cli
新命令需改固定构造表
end note
note bottom of domain
新形状需改工厂；属性与标签缺少扩展协议
end note
@enduml
