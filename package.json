{
  "name": "svg-editor-cli",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "由 Phase 1 重构的插件式 SVG CLI：四个扩展点、双装配与局部撤销",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc",
    "cli": "npm run build --silent && node dist/src/main.js",
    "test": "npm run build --silent && node --test dist/test/*.test.js",
    "check": "tsc --noEmit",
    "verify": "node scripts/verify-phase2.mjs",
    "verify:extensions": "node scripts/verify-extension-diffs.mjs",
    "metrics": "node scripts/metrics.mjs final p2 docs/metrics"
  },
  "dependencies": {
    "@xmldom/xmldom": "^0.9.12",
    "import-meta-resolve": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
