{
  "name": "dsh-code-atlas",
  "version": "0.3.0",
  "description": "Task review, design tradeoffs and small-step refactoring plans for DSH Desktop",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./remote": "./lib/typert.remote-client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "cordis.patch.yml",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12",
    "dsh": "0.2.0-rc.1"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "package": "npm run build && npm pack --pack-destination artifacts",
    "demo": "npm run build && node scripts/demo.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "dependencies": {
    "ignore": "7.0.5",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cordis-plugin-group": "1.0.4",
    "@deepseek-ai/cordis-plugin-include": "1.0.9",
    "@deepseek-ai/cordis-plugin-loader": "1.0.5",
    "@deepseek-ai/cordis-plugin-timer": "1.1.6",
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.1",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-workspace": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-workspace": "0.2.0-rc.1",
    "@types/node": "24.10.0",
    "@types/react": "18.3.1",
    "esbuild": "0.27.0",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1"
  }
}
